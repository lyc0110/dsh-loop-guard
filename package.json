{
  "name": "dsh-loop-guard",
  "version": "0.1.0",
  "description": "DSH llm/stream guard: detects reasoning or text output that degenerates into a periodic repetition loop and aborts the request instead of streaming until the user gives up.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "llm",
    "loop",
    "guard"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
